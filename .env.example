# Copy this file to ".env" for local development.  NEVER commit ".env".
#
# These three values are PUBLIC by design (they end up in the browser bundle).
# Security comes from Row Level Security in the database, not from hiding them.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Full public address of the site, with trailing slash (used for canonical URLs, Open Graph, sitemap).
VITE_SITE_URL=http://localhost:5173/

# "/" locally. On GitHub Pages the deploy workflow sets "/<repository-name>/" automatically.
VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# DO NOT PUT THESE IN THIS FILE OR ANYWHERE IN THE REPOSITORY:
#   - Supabase service_role / sb_secret_ key
#   - TMDB API key          -> Supabase Edge Function secret  TMDB_API_KEY
#   - Gemini (AI) API key   -> Supabase Edge Function secret  GEMINI_API_KEY
# ---------------------------------------------------------------------------
